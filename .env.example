# Client API target
NEXT_PUBLIC_API_URL=http://localhost:5000

# Better Auth values are likely server-side, but listed here for planning.
# Do not expose server secrets in NEXT_PUBLIC variables.
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-secure-secret

# MongoDB Atlas should be used by the server only.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fraudshieldbd

# Cloudinary should be used by the server for signed uploads or secure upload routes.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
